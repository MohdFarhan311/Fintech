# Copy this file to .env and replace each CHANGE_ME value before starting.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=CHANGE_ME_use_a_long_random_value
MONGO_APP_USERNAME=flextenure_app
MONGO_APP_PASSWORD=CHANGE_ME_use_a_long_random_value
JWT_SECRET=CHANGE_ME_use_a_long_random_value

# Host port for the website. The API and database stay private.
HTTP_PORT=8080
